{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-units.schema.json",
  "title": "fmblueprint planning task units",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "properties": { "schema_version": { "const": 1 }, "tasks": { "type": "array", "items": { "type": "object", "required": ["id", "title", "kind", "status", "source_object_ids", "depends_on"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "kind": { "type": "string" }, "status": { "const": "planning_hint" }, "source_object_ids": { "type": "array", "items": { "type": "string" } }, "depends_on": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } } },
  "additionalProperties": false
}
